<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base selon la version d'Android : voir values-v29 et values-v35. -->
    <style name="BaseTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="AppTheme" parent="BaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/screen_background</item>
        <item name="android:colorPrimaryDark">@color/screen_background</item>
        <item name="android:colorAccent">@color/action_primary</item>
        <item name="android:colorControlActivated">@color/action_primary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textColorLink">@color/text_primary</item>
        <item name="android:fontFamily">@font/barlow_semicondensed_regular</item>
    </style>

    <!-- Feuille de choix, posée sur l'écran d'accueil. -->
    <style name="NearbySheet" parent="AppTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@drawable/sheet_background</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <!-- Textes -->
    <style name="Text">
        <item name="android:fontFamily">@font/barlow_semicondensed_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Display">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Text.Heading">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="Text.SectionTitle">
        <item name="android:fontFamily">@font/barlow_semicondensed_semibold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Label">
        <item name="android:fontFamily">@font/barlow_semicondensed_semibold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Overline">
        <item name="android:fontFamily">@font/barlow_semicondensed_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.RowTitle">
        <item name="android:fontFamily">@font/barlow_semicondensed_semibold</item>
        <item name="android:textSize">16.5sp</item>
    </style>

    <style name="Text.RowTitleLight">
        <item name="android:fontFamily">@font/barlow_semicondensed_medium</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Text.RowSubtitle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Status">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">13.5sp</item>
    </style>

    <style name="Text.Help">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Text.Paragraph">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.Legal">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.Mention">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textColorLink">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- Actions -->
    <style name="IconAction">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="ActionPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_action_primary</item>
        <item name="android:fontFamily">@font/barlow_semicondensed_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_action_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ActionPrimary.Small">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_action_primary_small</item>
        <item name="android:textSize">16.5sp</item>
    </style>

    <style name="ActionSecondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_action_secondary</item>
        <item name="android:fontFamily">@font/barlow_semicondensed_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16.5sp</item>
    </style>

    <!-- Barre du bas : reste visible au-dessus de la liste. -->
    <style name="BottomBar">
        <item name="android:background">@color/screen_background</item>
        <item name="android:paddingStart">@dimen/screen_padding</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">@dimen/screen_padding</item>
        <item name="android:paddingBottom">24dp</item>
    </style>
</resources>

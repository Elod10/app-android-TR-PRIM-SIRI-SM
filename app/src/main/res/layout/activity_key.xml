<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/IconAction"
            android:layout_marginStart="9dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <TextView
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_key_title" />

            <TextView
                style="@style/Text.Paragraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/main_key_help" />

            <TextView
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="10dp"
                android:fontFamily="@font/barlow_semicondensed_medium"
                android:gravity="center_vertical"
                android:text="@string/key_gain_platform"
                android:textSize="16.5sp" />

            <TextView
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="10dp"
                android:fontFamily="@font/barlow_semicondensed_medium"
                android:gravity="center_vertical"
                android:text="@string/key_gain_minute"
                android:textSize="16.5sp" />

            <TextView
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="10dp"
                android:fontFamily="@font/barlow_semicondensed_medium"
                android:gravity="center_vertical"
                android:text="@string/key_gain_modes"
                android:textSize="16.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/key_input"
                    android:text="@string/key_field_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp">

                    <EditText
                        android:id="@id/key_input"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="monospace"
                        android:hint="@string/main_key_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPassword|textNoSuggestions"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/key_show"
                        style="@style/IconAction"
                        android:contentDescription="@string/main_key_show"
                        android:src="@drawable/ic_eye" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/key_test"
                        style="@style/ActionSecondary"
                        android:layout_width="0dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/main_key_test" />

                    <Button
                        android:id="@+id/key_save"
                        style="@style/ActionPrimary.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/main_key_save" />
                </LinearLayout>

                <TextView
                    android:id="@+id/key_status"
                    style="@style/Text.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Consommation du quota du jour, quand une clé est enregistrée. -->
            <LinearLayout
                android:id="@+id/key_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/key_usage_title" />

                <TextView
                    android:id="@+id/key_usage_value"
                    style="@style/Text.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="20sp" />

                <ProgressBar
                    android:id="@+id/key_usage_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:progressBackgroundTint="@color/divider"
                    android:progressTint="@color/text_primary" />

                <TextView
                    android:id="@+id/key_usage_help"
                    style="@style/Text.Help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/key_get_title" />

            <TextView
                style="@style/Text.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/key_get_body"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/key_portal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_action_secondary"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableEnd="@drawable/ic_open"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/barlow_semicondensed_semibold"
                    android:gravity="center_vertical"
                    android:text="@string/main_key_open_portal"
                    android:textColor="@color/text_primary"
                    android:textSize="16.5sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/key_privacy"
                style="@style/Text.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/key_privacy" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

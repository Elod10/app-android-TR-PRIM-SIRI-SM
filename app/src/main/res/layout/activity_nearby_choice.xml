<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <TextView
        style="@style/Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/nearby_title" />

    <TextView
        style="@style/Text.RowSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="8dp"
        android:text="@string/nearby_help"
        android:textSize="14.5sp" />

    <TextView
        android:id="@+id/nearby_status"
        style="@style/Text.Paragraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding"
        android:visibility="gone" />

    <ListView
        android:id="@+id/nearby_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <include
        layout="@layout/view_data_mention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="16dp" />
</LinearLayout>

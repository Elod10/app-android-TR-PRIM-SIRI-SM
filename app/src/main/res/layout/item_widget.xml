<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/item_widget_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/item_widget_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/item_widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/item_widget_texts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/item_widget_title"
                    style="@style/Text.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/item_widget_subtitle"
                    style="@style/Text.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/item_widget_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/item_widget_refresh"
                    style="@style/IconAction"
                    android:contentDescription="@string/main_widget_refresh"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/item_widget_configure"
                    style="@style/IconAction"
                    android:contentDescription="@string/main_widget_configure"
                    android:src="@drawable/ic_edit" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/item_widget_primary"
            style="@style/ActionPrimary.Small"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

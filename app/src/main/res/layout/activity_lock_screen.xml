<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/IconAction"
            android:layout_marginStart="9dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <TextView
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lock_title" />

            <TextView
                android:id="@+id/lock_widget"
                style="@style/Text.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <!-- Notification -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/lock_notify_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <Switch
                    android:id="@+id/notify_switch"
                    style="@style/Text.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/notify_title" />

                <TextView
                    style="@style/Text.Help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/lock_notify_help" />

                <!-- Live Update, Android 16 et plus -->
                <LinearLayout
                    android:id="@+id/live_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/divider" />

                    <Switch
                        android:id="@+id/live_switch"
                        style="@style/Text.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/lock_live_title" />

                    <TextView
                        style="@style/Text.Help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lock_live_help" />

                    <TextView
                        android:id="@+id/live_status"
                        style="@style/Text.Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/live_settings"
                        style="@style/ActionSecondary"
                        android:layout_marginTop="10dp"
                        android:text="@string/lock_live_settings"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Position, pour les widgets qui la suivent -->
            <LinearLayout
                android:id="@+id/follow_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/lock_follow_section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <Switch
                        android:id="@+id/follow_switch"
                        style="@style/Text.RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/lock_follow_title" />

                    <TextView
                        style="@style/Text.Help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lock_follow_help" />

                    <TextView
                        android:id="@+id/follow_status"
                        style="@style/Text.Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/follow_allow"
                        style="@style/ActionPrimary.Small"
                        android:layout_marginTop="10dp"
                        android:text="@string/lock_follow_allow"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Plage horaire -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/lock_window_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding">

                <RadioGroup
                    android:id="@+id/window_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/window_always"
                        style="@style/Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="45dp"
                        android:paddingStart="8dp"
                        android:text="@string/lock_window_always" />

                    <RadioButton
                        android:id="@+id/window_some"
                        style="@style/Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="45dp"
                        android:paddingStart="8dp"
                        android:text="@string/lock_window_some" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/window_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/window_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/window_start"
                            style="@style/ActionSecondary"
                            android:layout_width="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/window_end"
                            style="@style/ActionSecondary"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/window_help"
                style="@style/Text.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lock_window_help" />

            <!-- Tuile des réglages rapides -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/lock_tile_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/tile_status"
                    style="@style/Text.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Text.Help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/lock_tile_help" />

                <Button
                    android:id="@+id/tile_choose"
                    style="@style/ActionSecondary"
                    android:layout_marginTop="10dp"
                    android:text="@string/lock_tile_choose" />

                <Button
                    android:id="@+id/tile_add"
                    style="@style/ActionSecondary"
                    android:layout_marginTop="8dp"
                    android:text="@string/lock_tile_add"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

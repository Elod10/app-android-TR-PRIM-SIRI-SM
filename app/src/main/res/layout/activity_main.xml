<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Le bas réserve la place du bouton « Soutenir », qui flotte au-dessus de la liste. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="64dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingEnd="9dp">

                    <TextView
                        style="@style/Text.Display"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name" />

                    <ImageButton
                        android:id="@+id/open_settings"
                        style="@style/IconAction"
                        android:contentDescription="@string/settings_title"
                        android:src="@drawable/ic_settings" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widgets_title"
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_padding"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="@dimen/screen_padding"
                    android:layout_marginBottom="16dp"
                    android:text="@string/main_widgets_title" />

                <LinearLayout
                    android:id="@+id/widgets_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingEnd="@dimen/screen_padding" />

                <LinearLayout
                    android:id="@+id/widgets_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/screen_padding"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:src="@drawable/preview_deux_sens_large" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="348">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="172"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:src="@drawable/preview_un_sens" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="84"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:src="@drawable/preview_pastille" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="@string/main_empty_title" />

                    <TextView
                        style="@style/Text.Paragraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/main_empty_body" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/open_support"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_support_pill"
            android:clickable="true"
            android:contentDescription="@string/support_short_description"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_coffee" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/barlow_semicondensed_semibold"
                android:importantForAccessibility="no"
                android:text="@string/support_short"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        style="@style/BottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/add_widget"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_action_primary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="8dp"
                android:fontFamily="@font/barlow_semicondensed_semibold"
                android:gravity="center_vertical"
                android:text="@string/main_add_widget"
                android:textColor="@color/on_action_primary"
                android:textSize="18sp" />
        </FrameLayout>

        <include
            layout="@layout/view_data_mention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Alarme exacte (non réveillante) pour recalculer les temps d'attente chaque minute.
         Accordée d'office jusqu'à Android 13 ; à partir d'Android 14, l'usager l'autorise
         (« Alarmes et rappels ») depuis l'accueil de l'appli. USE_EXACT_ALARM est réservée
         par le Play Store aux réveils et aux agendas. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Mode automatique : par défaut, position lue seulement quand on touche le widget. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Facultative (« Toujours autoriser ») : un widget peut relire la position à chaque actualisation,
         écran allumé, si on l'active pour lui. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Notification facultative d'un widget, lisible sur l'écran de verrouillage. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 : mise en avant de cette notification (Live Update), pendant sa plage horaire. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Appui long sur la tuile des réglages rapides. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddWidgetActivity"
            android:exported="false"
            android:label="@string/main_add_widget" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.KeyActivity"
            android:exported="false"
            android:label="@string/main_key_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.LockScreenActivity"
            android:exported="false"
            android:label="@string/lock_title" />

        <activity
            android:name=".ui.SourcesActivity"
            android:exported="false"
            android:label="@string/main_sources_title" />

        <activity
            android:name=".ui.ConfigureActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/configure_title"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.NearbyChoiceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/NearbySheet" />

        <service
            android:name=".widget.DeparturesTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_departures"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".widget.AutoLocateService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".widget.DeparturesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_auto_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/departures_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PastilleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_pastille_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_pastille" />
        </receiver>

        <receiver
            android:name=".widget.UnSensWidgetProvider"
            android:exported="true"
            android:label="@string/widget_un_sens_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_un_sens" />
        </receiver>

        <receiver
            android:name=".widget.GrandChiffreWidgetProvider"
            android:exported="true"
            android:label="@string/widget_grand_chiffre_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_grand_chiffre" />
        </receiver>

        <receiver
            android:name=".widget.FriseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_frise_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_frise" />
        </receiver>

        <receiver
            android:name=".widget.CompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_compact" />
        </receiver>

        <receiver
            android:name=".widget.DeuxSensWidgetProvider"
            android:exported="true"
            android:label="@string/widget_deux_sens_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_deux_sens" />
        </receiver>

        <receiver
            android:name=".widget.DeuxSensLargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_deux_sens_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_deux_sens_large" />
        </receiver>

        <receiver
            android:name=".widget.TrainWidgetProvider"
            android:exported="true"
            android:label="@string/widget_train_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_train" />
        </receiver>

        <receiver
            android:name=".widget.ListeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_liste_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_liste" />
        </receiver>

        <receiver
            android:name=".widget.ProximiteWidgetProvider"
            android:exported="true"
            android:label="@string/widget_proximite_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_proximite" />
        </receiver>

        <receiver
            android:name=".widget.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

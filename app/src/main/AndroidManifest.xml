<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Alarme exacte (non réveillante) pour recalculer les temps d'attente chaque minute. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Mode automatique : position lue seulement quand on touche le widget, jamais en arrière-plan. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ConfigureActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/configure_title"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.NearbyChoiceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/NearbySheet" />

        <service
            android:name=".widget.AutoLocateService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".widget.DeparturesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_auto_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/departures_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PastilleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_pastille_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_pastille" />
        </receiver>

        <receiver
            android:name=".widget.UnSensWidgetProvider"
            android:exported="true"
            android:label="@string/widget_un_sens_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_un_sens" />
        </receiver>

        <receiver
            android:name=".widget.GrandChiffreWidgetProvider"
            android:exported="true"
            android:label="@string/widget_grand_chiffre_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_grand_chiffre" />
        </receiver>

        <receiver
            android:name=".widget.FriseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_frise_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_frise" />
        </receiver>

        <receiver
            android:name=".widget.CompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_compact" />
        </receiver>

        <receiver
            android:name=".widget.DeuxSensWidgetProvider"
            android:exported="true"
            android:label="@string/widget_deux_sens_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_deux_sens" />
        </receiver>

        <receiver
            android:name=".widget.DeuxSensLargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_deux_sens_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_deux_sens_large" />
        </receiver>

        <receiver
            android:name=".widget.TrainWidgetProvider"
            android:exported="true"
            android:label="@string/widget_train_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_train" />
        </receiver>

        <receiver
            android:name=".widget.ListeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_liste_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_liste" />
        </receiver>

        <receiver
            android:name=".widget.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
